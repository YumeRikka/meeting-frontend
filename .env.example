# 腾讯会议自建应用凭证（从 腾讯会议官网 → 用户中心 → 企业管理 → 高级 → REST API 复制）
# 注意：本文件只是模板，复制为 .env 后填入真实值；.env 绝不能提交/截图/发到群里
APPID=your_appid_here
SDKID=your_sdkid_here
SECRET_ID=your_secret_id_here
SECRET_KEY=your_secret_key_here

# 会议参数
MEETING_SUBJECT=临时会议
# 主持人 userid：必须是你企业账号下真实存在的用户ID（不是手机号，是后台通讯录里的 userid）
MEETING_USERID=your_host_userid_here
# 会议时长（分钟）
MEETING_DURATION=30
# 开始时间（Unix 秒级时间戳，留空=现在+2分钟）。例如：1763000000
MEETING_START_TIME=
